# Application Environment
ENVIRONMENT=development
DEBUG=True

# 1. Database: SQLite creates a local file automatically (zero setup needed)
DATABASE_URL=sqlite:///./finance_controller.db

# 2. AI Provider: "mock" uses the built-in deterministic heuristic auditor
# It classifies edge cases, duplicates, and discrepancies with zero API keys!
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MODEL_NAME=gpt-4o-mini

# 3. Decision Thresholds
AUTO_MATCH_THRESHOLD=0.90      # Scores >= 0.90 automatically match
AI_REVIEW_THRESHOLD=0.70       # Scores between 0.70 and 0.90 trigger AI verification

# 4. Proximity Tolerances for Candidate Search
AMOUNT_TOLERANCE_PCT=0.05      # 5% fee variance tolerance (e.g. gateway MDR fees)
AMOUNT_TOLERANCE_FIXED=50.0   # Currency units difference tolerance
DATE_TOLERANCE_DAYS=5          # Max days settlement lag to pair transactions

# 5. Multi-Factor Scoring Weights (Must sum to 1.0)
WEIGHT_AMOUNT=0.40             # 40% weight on monetary amount match
WEIGHT_REFERENCE=0.25          # 25% weight on reference ID overlap
WEIGHT_DATE=0.20               # 20% weight on transaction date proximity
WEIGHT_CUSTOMER=0.15           # 15% weight on normalized customer/entity name